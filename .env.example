# ─────────────────────────────────────────────────────────────
# Ploi Panel + bundled API — environment reference
# Works with:  docker run --env-file .env.example ...
#              Render (set the same keys in the dashboard)
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
# Example values — safe for local testing. This file is public, so before
# going to production regenerate both:
#   APP_KEY:    head -c 32 /dev/urandom | base64        →  base64:...
#   PLOI_TOKEN: python3 -c "import secrets; print(secrets.token_urlsafe(45))"
APP_KEY=base64:e//wnmM5ffbfo2XQsase5u19TMO1t8jx5qedHJZk47Y=
APP_ENV=production
APP_DEBUG=false
# Public URL of the panel, e.g. https://your-service.onrender.com
APP_URL=http://localhost
LOG_CHANNEL=stderr

# ── Database ─────────────────────────────────────────────────
# External PostgreSQL, shared by the panel and the bundled API.
DATABASE_URL=pgsql://user:password@host:5432/ploi_panel
# DB_URL=          # alternative name, same value

# ── Panel ↔ bundled API ──────────────────────────────────────
# Bearer token the panel uses against the bundled API.
# Its presence also marks the panel as "installed".
PLOI_TOKEN=EkgEOwr90c6H1hpCc77w9XXVq5vmTpeZqIr-iCXR3WgwuJgfz6lz7MuDBZt_
# Internal address of the bundled API — only change if you host it separately.
PLOI_API_URL=http://127.0.0.1:8081/
# PLOI_STUB_TOKEN=            # defaults to PLOI_TOKEN
PLOI_STUB_PROVISION_DELAY=2   # seconds until a stubbed resource reports "active"

# ── First admin (seeded once at boot; skipped if the user exists) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ── Runtime drivers (defaults baked into the image) ─────────
SESSION_DRIVER=cookie
QUEUE_CONNECTION=sync
CACHE_DRIVER=file
CACHE_STORE=file
MAIL_MAILER=log

# ── HTTP ports (container) ───────────────────────────────────
PORT=8080         # panel — Render sets this automatically
API_PORT=8081     # bundled API — internal (localhost) only

# ── Optional: billing (Stripe) ───────────────────────────────
# STRIPE_KEY=
# STRIPE_SECRET=
# CASHIER_MODEL=App\Models\User

# ── Optional: real email (default: log driver) ───────────────
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"
